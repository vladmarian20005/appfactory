# Usage, from factory/tools/fastlane:
#   APP_DIR=../../apps/<slug>/ios SCHEME=<Target> BUNDLE_ID=<bundle> fastlane beta
#   APP_DIR=../../apps/<slug>/ios SCHEME=<Target> BUNDLE_ID=<bundle> fastlane release
# Needs: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (App Store Connect API key .p8), TEAM_ID.

default_platform(:ios)

def app_dir  = File.expand_path(ENV.fetch("APP_DIR"))
def scheme   = ENV.fetch("SCHEME")
def project  = File.join(app_dir, "#{scheme}.xcodeproj")
def store    = File.expand_path("../store", app_dir)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
  end

  desc "Archive and upload to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: project, build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_app(project: project, scheme: scheme, export_method: "app-store", clean: true,
              xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')} -allowProvisioningUpdates")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Push metadata + screenshots and submit the latest build for review"
  lane :release do
    deliver(
      metadata_path: File.join(store, "metadata"),
      screenshots_path: File.join(store, "screenshots"),
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end

  desc "Create the app record in App Store Connect"
  lane :create do
    produce(app_name: ENV.fetch("APP_NAME"), language: "English", sku: ENV.fetch("BUNDLE_ID"))
  end
end
